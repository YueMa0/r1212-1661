def RamseyIncrement.ramseyNumber : ℕ → ℕ → ℕ :=
fun k s => Nat.find ⋯
def RamseyIncrement.ForcesRamsey : ℕ → ℕ → ℕ → Prop :=
fun n k s => ∀ (G : SimpleGraph (Fin n)), ¬RamseyIncrement.IsRamseyFree G k s
def RamseyIncrement.HasRamseyColoring : ℕ → ℕ → ℕ → Prop :=
fun n k s => ∃ G, RamseyIncrement.IsRamseyFree G k s
def RamseyIncrement.IsRamseyFree.{u_1} : {V : Type u_1} → SimpleGraph V → ℕ → ℕ → Prop :=
fun {V} G k s => G.CliqueFree k ∧ Gᶜ.CliqueFree s
