def RamseyIncrement.IsRamseyFree.{u_1} :
  forall {V : Type u_1}, SimpleGraph V → Nat → Nat → Prop :=
  fun {V : Type u_1} (G : SimpleGraph V) (k s : Nat) =>
  And (SimpleGraph.CliqueFree G k) (SimpleGraph.CliqueFree (Compl.compl G) s)

def SimpleGraph.CliqueFree.{u_1} :
  forall {α : Type u_1}, SimpleGraph α → Nat → Prop :=
  fun {α : Type u_1} (G : SimpleGraph α) (n : Nat) => forall (t : Finset α), Not (SimpleGraph.IsNClique G n t)

inductive SimpleGraph.IsNClique.{u_1} {α : Type u_1} : SimpleGraph α → Nat → Finset α → Prop

def SimpleGraph.IsClique.{u_1} :
  forall {α : Type u_1}, SimpleGraph α → Set α → Prop :=
  fun {α : Type u_1} (G : SimpleGraph α) (s : Set α) => Set.Pairwise s (SimpleGraph.Adj G)

